pipeline {
    agent any

    stages {

        stage('Checkout with branch') {
            steps {
                git branch: 'main', url: 'https://github.com/Adutta1998/python-jenkins'
            }
        }
        stage('setup UV'){
            steps {
                bat 'pip install uv'
            }
        }
        stage('Install Dependencies') {
            steps {
                bat 'uv pip install -r requirements.txt'
            }
        }
        stage('Setup venv and run app') {
            steps {
                bat 'uv python main.py'
            }
        }

    }
}